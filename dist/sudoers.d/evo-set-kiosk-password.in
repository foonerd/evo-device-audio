# sudoers drop-in template — installed by the bootstrap
# script at /etc/sudoers.d/evo-set-kiosk-password with mode
# 0440, owned root:root.
#
# Allows the steward service user (substituted at install
# time for the `@EVO_SERVICE_USER@` placeholder) to invoke
# `/usr/sbin/chpasswd -c SHA512 -R /` via sudo without a
# password. This is the narrowest scope required by the
# framework's `set_kiosk_password` wire op — one binary
# path, three flags, no wildcards, no `ALL`.
#
# The framework pipes `<runtime_user>:<new_password>\n` on
# stdin to chpasswd; the flags force:
#
#   -c SHA512    Encoding is SHA-512-crypt (`$6$`), matching
#                the format the framework's ShadowAuthService
#                verifies against. Overrides the distribution's
#                default `ENCRYPT_METHOD` — the framework
#                controls the stored hash format explicitly.
#   -R /         Root directory pinned to `/`. Defensive; the
#                default is the same value but this makes the
#                sudoers pattern robust to a future chpasswd
#                that would pick up a different root from an
#                environment variable.
#
# Path discipline: the binary path MUST match the string the
# `handle_set_kiosk_password` function in `crates/evo/src/
# server.rs` invokes. Both paths + flag order are pinned by
# the framework at compile time; any drift breaks sudo
# argv-match.
#
# Apply via the bootstrap script:
#   scripts/bootstrap.sh --install-set-kiosk-password-sudoers
#
# Or manually (substitute the placeholder):
#   sed 's/@EVO_SERVICE_USER@/<your-service-user>/' \
#       dist/sudoers.d/evo-set-kiosk-password.in \
#       | sudo install -m 0440 -o root -g root /dev/stdin \
#         /etc/sudoers.d/evo-set-kiosk-password
#
# `visudo -c -f /etc/sudoers.d/evo-set-kiosk-password`
# verifies syntactically valid sudoers.

Cmnd_Alias EVO_SET_KIOSK_PASSWORD = \
    /usr/sbin/chpasswd -c SHA512 -R /

Defaults!EVO_SET_KIOSK_PASSWORD !pam_session, !syslog

@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_SET_KIOSK_PASSWORD
