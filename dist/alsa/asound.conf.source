# Modular ALSA pipeline definition for evo-device-audio source-hosts.
# Installed at `/etc/asound.conf` by the distribution's bootstrap
# script when `--multiroom-role=source` is supplied. ALSA reads
# `/etc/asound.conf` (system-wide) at every PCM open; no include
# glob needed — this is the canonical place for the system's audio
# pipeline definition.
#
# Source-host distinction: `pcm.evo` writes ONLY to the
# snd-aloop playback half. The multiroom plugin captures from the
# matching loopback capture half and owns all local-DAC writes via
# `alsa_pcm` (typically `evo_local`) on the same scheduler path
# that fans out to remote receivers.
#
# Pipeline shape:
#
#   MPD (or any evo producer)
#       → pcm.evo
#           → plug
#           → hw:CARD=Loopback,DEV=0,SUBDEV=0
#                         ↓ (kernel mirror)
#                      hw:CARD=Loopback,DEV=1,SUBDEV=0
#                         ↓
#                 evo multiroom plugin `source_pcm` capture target
#                         ↓
#                 plugin fan-out scheduler writes:
#                   - remote receivers (audio-plane TCP)
#                   - local DAC via `alsa_pcm` (typically `evo_local`)
#
# `@EVO_AUDIO_CARD@` is substituted at install time by
# bootstrap.sh from the operator-supplied (or auto-detected) ALSA
# card name. The `Loopback` card name is the kernel-stable name
# the `snd-aloop` module exposes; bootstrap.sh loads the module
# at install time and persists it via /etc/modules-load.d/.
#
# Subdevice convention: this template binds the source-host producer
# path to `SUBDEV=0`. snd-aloop exposes 8 subdevices per direction;
# playback subdevice N mirrors to capture subdevice N. The source-role
# plugin config should set `source_pcm` to the matching capture side.

pcm.evo {
    type plug
    slave.pcm "hw:CARD=Loopback,DEV=0,SUBDEV=0"
    hint {
        show on
        description "evo: source-host producer to snd-aloop playback"
    }
}

pcm.evo_local {
    type plug
    slave.pcm "hw:CARD=@EVO_AUDIO_CARD@,DEV=0"
    hint {
        show on
        description "evo: source-host local DAC renderer target"
    }
}

pcm.evo_loopback_capture {
    type hw
    card "Loopback"
    device 1
    subdevice 0
    hint {
        show on
        description "evo: source-host loopback capture target"
    }
}

ctl.evo {
    type hw
    card "@EVO_AUDIO_CARD@"
}

# Operator-options drop-in. Source-hosts include the same drop-in
# path as receiver/standalone, but delivery.alsa renders the source
# variant to `pcm.evo_local*` nodes only, leaving producer
# `pcm.evo` (loopback) untouched.
</etc/asound.d/evo-options.conf>
