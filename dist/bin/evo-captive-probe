#!/bin/sh
# evo-captive-probe — narrow root-elevated captive-plane HTTP.
#
# The org.evoframework.network plugin uses this wrapper to force
# captive-portal traffic to egress through a specific network
# interface (SO_BINDTODEVICE), which curl cannot do when invoked
# without CAP_NET_RAW / root.
#
# Rationale: `curl --interface <IP>` only sets the source IP;
# the kernel still picks the egress by routing table, so on a
# device with two uplinks (e.g. eth0 admin + wlan0 captive
# segment) a wlan0-source-bound probe still leaves via eth0
# when eth0 owns the default route — and never sees the portal.
# `curl --interface <ifname>` (device name, not IP) sets
# SO_BINDTODEVICE, which forces egress via that interface but
# requires root. This wrapper is the elevation boundary.
#
# Usage:
#   evo-captive-probe <ifname> <mode> <url> [field value]...
#
#   ifname   Kernel interface name (wlan0 / wlan1 / ...).
#            Validated against /sys/class/net so a bad arg
#            fails before touching curl.
#   mode     One of:
#              probe                — GET probe, `-w`
#                                     `%{http_code}|%{url_effective}`
#                                     to stdout, no body, --max-time 20.
#              capport-get          — GET with `Accept:
#                                     application/captive+json`
#                                     (RFC 8908), response body to
#                                     stdout, --max-time 10.
#              submit               — POST with `--data-urlencode
#                                     field=value` per key/value
#                                     pair on argv, `-w` metrics to
#                                     stdout, no body, --max-time 25.
#              submit-capport-json  — as submit, plus both
#                                     `Accept: application/captive+json`
#                                     and `Content-Type:
#                                     application/captive+json`
#                                     headers.
#              proxy-fetch          — arbitrary HTTP verb (GET / POST /
#                                     PUT / DELETE / HEAD / OPTIONS /
#                                     PATCH) with caller-supplied
#                                     header set and optional request
#                                     body from stdin. Response headers
#                                     (including the HTTP status line)
#                                     stream to stdout followed by
#                                     `\r\n\r\n` then the raw response
#                                     body. `-L` is NOT set; redirects
#                                     surface as 3xx + `Location` so
#                                     the framework proxy can rewrite
#                                     the Location into its
#                                     session-prefixed URL and let the
#                                     operator's browser follow through
#                                     the proxy. Cookies travel via
#                                     the caller's Cookie: header
#                                     (jar owned by the plugin, keyed
#                                     by session_id).
#   url      http:// or https:// only. Any other scheme is
#            rejected before invocation.
#   field    Form-field name (submit modes only). Followed by
#   value    the field value. Pairs may repeat.
#
# proxy-fetch argv extension:
#   evo-captive-probe <ifname> proxy-fetch <method> <url>
#                     [--body-stdin] [name value]...
#
#   method       One of GET / POST / PUT / DELETE / HEAD /
#                OPTIONS / PATCH (case-sensitive). Any other
#                verb is rejected.
#   --body-stdin Optional flag; when present, curl reads the
#                request body from this process's stdin
#                (`--data-binary @-`). Content-Type MUST be set
#                explicitly by a caller-supplied header — curl
#                will NOT add `application/x-www-form-urlencoded`
#                since we're not using `--data-urlencode`.
#   name value   Header pair. Assembled inside the wrapper into
#                `-H "${name}: ${value}"` — the caller never
#                gets to name a curl flag directly. Pairs may
#                repeat; header ordering is preserved.
#
# All operator-supplied inputs (ifname, url, field, value) are
# passed through Rust's `Command::args`, so no shell
# interpolation occurs anywhere on the path — the wrapper does
# not need to defend against shell injection, only against
# curl-flag smuggling. Field/value pairs are assembled INSIDE
# the wrapper into `--data-urlencode "k=v"` tokens — the
# operator never gets to name a curl flag themselves, only a
# form field.
#
# Exit codes: 0 on curl success, 2 on argv-validation failure,
# any other non-zero on curl failure (propagated).
#
# Sudoers grant (installed by bootstrap.sh from
# dist/sudoers.d/evo-network-captive.in) restricts the service
# user to NOPASSWD invocation of this path only — the wrapper
# is the trust boundary, exactly the pattern already used for
# nmcli / iw / rfkill.

set -eu

CURL_BIN="/usr/bin/curl"

if [ ! -x "$CURL_BIN" ]; then
    echo "evo-captive-probe: $CURL_BIN not found or not executable" >&2
    exit 2
fi

if [ "$#" -lt 3 ]; then
    echo "usage: evo-captive-probe <ifname> <mode> <url> [field value]..." >&2
    exit 2
fi

IFNAME="$1"
MODE="$2"
URL="$3"
shift 3

case "$IFNAME" in
    ''|.*|*/*|*[!A-Za-z0-9_.-]*)
        echo "evo-captive-probe: invalid ifname: $IFNAME" >&2
        exit 2
        ;;
esac

if [ ! -e "/sys/class/net/$IFNAME" ]; then
    echo "evo-captive-probe: interface $IFNAME does not exist" >&2
    exit 2
fi

case "$MODE" in
    probe|capport-get|submit|submit-capport-json|proxy-fetch) : ;;
    *)
        echo "evo-captive-probe: unknown mode: $MODE" >&2
        exit 2
        ;;
esac

# For all modes except proxy-fetch, $3 is the URL. For proxy-fetch,
# $3 is the METHOD and $4 is the URL. Peel accordingly before the
# URL-scheme check.
if [ "$MODE" = "proxy-fetch" ]; then
    if [ "$#" -lt 1 ]; then
        echo "evo-captive-probe: proxy-fetch requires <url> after <method>" >&2
        exit 2
    fi
    PF_METHOD="$URL"
    URL="$1"
    shift
    case "$PF_METHOD" in
        GET|POST|PUT|DELETE|HEAD|OPTIONS|PATCH) : ;;
        *)
            echo "evo-captive-probe: proxy-fetch method must be one of GET|POST|PUT|DELETE|HEAD|OPTIONS|PATCH (got '$PF_METHOD')" >&2
            exit 2
            ;;
    esac
fi

case "$URL" in
    http://*|https://*) : ;;
    *)
        echo "evo-captive-probe: url must be http:// or https://" >&2
        exit 2
        ;;
esac

case "$MODE" in
    probe|capport-get)
        if [ "$#" -ne 0 ]; then
            echo "evo-captive-probe: field/value pairs only valid in submit modes" >&2
            exit 2
        fi
        ;;
    submit|submit-capport-json)
        if [ "$(( $# % 2 ))" -ne 0 ]; then
            echo "evo-captive-probe: submit modes require paired field value args" >&2
            exit 2
        fi
        ;;
    proxy-fetch)
        # Optional single --body-stdin flag preceding zero-or-more
        # header pairs. Validate parity of the remaining args
        # (excluding the flag) before the argv rewrite.
        PF_BODY_STDIN=0
        if [ "${1:-}" = "--body-stdin" ]; then
            PF_BODY_STDIN=1
            shift
        fi
        if [ "$(( $# % 2 ))" -ne 0 ]; then
            echo "evo-captive-probe: proxy-fetch header args must be paired name value" >&2
            exit 2
        fi
        ;;
esac

# Assemble curl argv into $@ in-place. Each `set --` call
# fully replaces positional args; use `"$@"` to preserve
# previously-set tokens so no string concatenation touches
# operator input.
case "$MODE" in

    probe)
        set -- \
            -sS -L \
            -o /dev/null \
            -w '%{http_code}|%{url_effective}' \
            --max-time 20 \
            --interface "$IFNAME" \
            "$URL"
        exec "$CURL_BIN" "$@"
        ;;

    capport-get)
        set -- \
            -sS -L \
            --max-time 10 \
            --interface "$IFNAME" \
            -H 'Accept: application/captive+json' \
            "$URL"
        exec "$CURL_BIN" "$@"
        ;;

    submit|submit-capport-json)
        # Positional args currently hold N field/value pairs.
        # Rewrite each pair into a `--data-urlencode "k=v"` token
        # pair. Consume from the front, append to the back; a
        # counter tracks the ORIGINAL pair count so the loop
        # terminates (each iteration nets zero change in $#).
        pairs_remaining=$#
        while [ "$pairs_remaining" -ge 2 ]; do
            k="$1"
            v="$2"
            shift 2
            set -- "$@" --data-urlencode "${k}=${v}"
            pairs_remaining=$((pairs_remaining - 2))
        done

        # Step 2: prepend the fixed curl flags + trailing URL.
        if [ "$MODE" = "submit-capport-json" ]; then
            set -- \
                -sS -L \
                -o /dev/null \
                -w '%{http_code}|%{url_effective}' \
                --max-time 25 \
                --interface "$IFNAME" \
                -X POST \
                -H 'Accept: application/captive+json' \
                -H 'Content-Type: application/captive+json' \
                "$@" \
                "$URL"
        else
            set -- \
                -sS -L \
                -o /dev/null \
                -w '%{http_code}|%{url_effective}' \
                --max-time 25 \
                --interface "$IFNAME" \
                -X POST \
                "$@" \
                "$URL"
        fi
        exec "$CURL_BIN" "$@"
        ;;

    proxy-fetch)
        # Positional args hold N header pairs (name value)*.
        # Rewrite each pair into `-H "name: value"`. Consume from
        # the front, append to the back; a counter tracks the
        # ORIGINAL pair count so the loop terminates (each
        # iteration nets zero change in $#).
        pairs_remaining=$#
        while [ "$pairs_remaining" -ge 2 ]; do
            hname="$1"
            hvalue="$2"
            shift 2
            set -- "$@" -H "${hname}: ${hvalue}"
            pairs_remaining=$((pairs_remaining - 2))
        done

        # Fixed curl flags for proxy-fetch:
        #   -sS                 quiet progress, show errors
        #   -D -                dump response headers to stdout
        #                       (includes the HTTP/1.1 status line)
        #   -o -                dump response body to stdout
        #                       (comes after the header block +
        #                       CRLF separator)
        #   --max-time 30       hard cap per upstream request
        #   --interface IFNAME  SO_BINDTODEVICE (curl-name form)
        #   -X METHOD           caller's HTTP verb
        #
        # -L is intentionally OMITTED: redirects surface as
        # 3xx + `Location` so the framework proxy can rewrite
        # `Location` into its session-prefixed same-origin URL
        # and let the operator's browser follow through the
        # proxy (each hop persists cookie state via the plugin's
        # session_id-keyed jar).
        if [ "$PF_BODY_STDIN" = "1" ]; then
            set -- \
                -sS \
                -D - \
                -o - \
                --max-time 30 \
                --interface "$IFNAME" \
                -X "$PF_METHOD" \
                --data-binary @- \
                "$@" \
                "$URL"
        else
            set -- \
                -sS \
                -D - \
                -o - \
                --max-time 30 \
                --interface "$IFNAME" \
                -X "$PF_METHOD" \
                "$@" \
                "$URL"
        fi
        exec "$CURL_BIN" "$@"
        ;;

esac
