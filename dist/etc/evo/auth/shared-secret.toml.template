# Framework shared-secret file — argon2id PHC hashes for
# operator step-up.
#
# The install script writes this file at /etc/evo/auth/shared-secret.toml
# (mode 0600, root:root). The framework reads it at boot; if
# the [[users]] table is empty, step-up denies until the
# operator sets a password via the kiosk shell's first-run
# `set_kiosk_password` flow. The kiosk shell then rewrites
# this file with the new hash — the operator never edits
# this file directly.
#
# Field reference (fixed schema; the framework refuses
# unknown schema_version values):
#
#   schema_version = 1
#
#   [[users]]
#   username      = "operator"                # framework identity — do not rename
#   password_hash = "$argon2id$v=19$m=..."    # PHC-format argon2id hash
#
# Only one user is supported at the reference-device tier;
# multi-operator identity differentiation lands in vendor
# distributions that compose additional AuthService
# implementations (PAM / vendor IdP) on top of the framework
# primitive.

schema_version = 1
