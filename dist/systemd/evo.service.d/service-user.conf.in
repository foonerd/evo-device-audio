# Systemd unit drop-in: set the steward's runtime identity.
#
# The framework's reference `evo.service.example` (evo-core-eng
# dist/systemd/) leaves service identity as a
# DISTRIBUTION-OWNED CHOICE — the steward runs as root if the
# distribution ships no drop-in. This distribution
# (evo-device-audio) picks Strategy A: a named unprivileged
# system tenant. Rationale:
#
#   1. Every sudoers drop-in this distribution ships
#      (evo-mpd-restart, evo-network-nm, evo-hardware-audio,
#      evo-system-power, evo-network-storage) grants NARROW
#      NOPASSWD escalation to a named tenant for a specific
#      privileged binary. Under a root steward those drop-ins
#      are theatrical — root does not need `sudo -n`. Under a
#      tenant steward they become the load-bearing privilege
#      surface: every escalation is scoped, auditable, and
#      reversible by removing the drop-in.
#
#   2. The steward's own footprint (writes to /run/evo,
#      /var/lib/evo, /etc/evo config-read, socket binds,
#      subject persistence, ledger append) needs no
#      capability beyond what an unprivileged user with
#      SupplementaryGroups=audio and the shipped sudoers
#      scoping provides.
#
#   3. Per-plugin OOP identity (each admitted plugin as its
#      own systemd unit with its own User=/CapabilityBoundingSet=/
#      SupplementaryGroups=) is the next primitive; this
#      drop-in is the necessary first step but does not by
#      itself deliver per-plugin isolation — plugins spawned
#      as steward child processes still inherit steward's
#      identity. Both directions of the privilege ladder
#      matter; this drop-in closes the base.
#
# Placement: `bootstrap.sh` renders this template (substituting
# @EVO_SERVICE_USER@ with the resolved tenant name) and installs
# the rendered file at
# `/etc/systemd/system/evo.service.d/service-user.conf`.
#
# Group choice: `Group=@EVO_SERVICE_USER@` uses the tenant's
# own primary group (created alongside the user account via
# `useradd -U` or `adduser`). `SupplementaryGroups=audio` grants
# read/write on /dev/snd/* for the ALSA plane. Additional
# supplementary groups (netdev, video, dialout, plugdev) are
# NOT added here — every one of those would broaden the
# privilege surface beyond what the steward's declared code
# paths require. Grants that need broader membership route
# through their own scoped sudoers drop-in instead.
#
# WorkingDirectory=/var/lib/evo pins CWD to the state
# directory so relative file operations in the steward (and
# any diagnostic core dumps) land under the state root
# rather than / or the invoking user's home.
#
# UMask=0027 keeps files the steward writes group-readable
# but world-unreadable — matches the 0750 default on the
# state directory itself.

[Service]
User=@EVO_SERVICE_USER@
Group=@EVO_SERVICE_USER@
SupplementaryGroups=audio
WorkingDirectory=/var/lib/evo
UMask=0027
