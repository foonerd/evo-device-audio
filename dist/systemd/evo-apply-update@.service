# The updater's worker. One instance per request, started by
# `evo-apply-update` (the sudo target) as `evo-apply-update@<token>.service`.
# It runs as root in its own cgroup and mount namespace, outside the
# steward's sandbox, so it can replace a plugin bundle and a wrapper, and so
# a restart of `evo` does not stop it. The token is a closed grammar the
# worker parses again before it does anything.
#
# Installed by the installer as root; the updater never delivers this file.
[Unit]
Description=evo updater worker (%i)

[Service]
Type=oneshot
User=root
ExecStart=/usr/libexec/evo-apply-update/evo-apply-update-worker %i
TimeoutStartSec=900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
