# sudoers drop-in template — installed by the bootstrap
# script at /etc/sudoers.d/evo-network-shares with mode 0440,
# owned root:root.
#
# Grants the steward service user (substituted at install
# time for the `@EVO_SERVICE_USER@` placeholder) NOPASSWD
# access to the binaries the framework's NetworkSharesRuntime
# invokes to mount / unmount / discover network shares (SMB /
# NFS).
#
# Scoped Cmnd_Alias declarations:
#
# 1. `EVO_NETWORK_SHARES_MOUNT` — mount + umount for CIFS /
#    NFS shares. The runtime dispatches these via its
#    SubprocessMountExecutor with argv lists composed by
#    `build_cifs_mount_args`, `build_nfs_mount_args`, and
#    `build_umount_args`. `mount` requires elevation because
#    it edits the kernel mount table. `umount` (including the
#    lazy-detach variant `-l` used for busy CIFS mounts) is
#    granted the same way — refusing lazy detach would leave
#    stuck mounts across share edit / remove operations.
#
# 2. `EVO_NETWORK_SHARES_DISCOVERY` — the LAN NAS discovery
#    substrate invokes `avahi-browse` and `smbclient` under
#    fixed argv shapes (`-atrkp _smb._tcp` for browse; `-N -L
#    <ip> -m SMB3_11 --debuglevel=4` for smbclient). These are
#    read-only enumeration commands that the framework may run
#    on a 5-minute cadence + on operator-issued
#    `network.discovery.refresh`, so `!pam_session, !syslog`
#    suppresses PAM session lines for the alias to keep the
#    journal free of litter for a benign read.
#
# Path discipline: the mount + umount paths MUST match
# `NetworkSharesRuntimeBuilder::with_mount_program` /
# `with_umount_program` (defaults `/bin/mount` + `/bin/umount`).
# `avahi-browse` and `smbclient` paths MUST match the runtime
# builder's `with_avahi_browse_program` /
# `with_smbclient_program` (defaults `/usr/bin/avahi-browse` +
# `/usr/bin/smbclient`). Distributions with non-standard
# paths override via the builder and add new substitutions
# to the bootstrap script.
#
# Argv scoping: `/bin/mount` and `/bin/umount` intentionally
# accept any argument list. Sudoers argv-match against mount's
# option flags (comma-separated `-o vers=3.0,file_mode=0777,...`
# for CIFS; `-t nfs4 -o vers=4.2,timeo=30,retrans=5,...` for
# NFS) is brittle — any operator advanced_options rewrite
# reorders the flags and breaks the match, and the mount
# binary itself is the trust boundary. `avahi-browse` and
# `smbclient` are similarly wildcarded because the runtime's
# argv builders are pinned by the framework and re-scoping at
# the sudoers layer duplicates the runtime's own construction
# invariants.
#
# Apply via the bootstrap script:
#   scripts/bootstrap.sh --install-network-shares-sudoers
#
# Or manually (substitute the placeholder):
#   sed 's/@EVO_SERVICE_USER@/<your-service-user>/' \
#       dist/sudoers.d/evo-network-shares.in \
#       | sudo install -m 0440 -o root -g root /dev/stdin \
#         /etc/sudoers.d/evo-network-shares
#
# `visudo -c -f /etc/sudoers.d/evo-network-shares` verifies
# syntactically valid sudoers.

Cmnd_Alias EVO_NETWORK_SHARES_MOUNT = \
    /usr/bin/systemd-mount, \
    /usr/bin/systemd-umount, \
    /bin/mount, \
    /bin/umount

# Force eject only. The operator has asked for the share to be
# gone while something still holds it, and the detach has to
# happen inside PID 1's mount namespace: `systemd-mount
# --collect` attached the volume there, so a lazy detach from
# the service's own namespace would drop only this view of it.
#
# ARGV-SCOPED, unlike the alias above, and deliberately so.
# `nsenter` takes the command to run as an argument, so an
# unscoped grant of this binary is a root shell for the asking
# — a different class of grant from `mount` and `umount`,
# which are bounded by what those binaries do. The shape below
# is composed by `build_force_detach_argv`, which is pure and
# pinned, so scoping it is stable rather than brittle: nothing
# an operator types reaches this argv. The trailing wildcard
# is the share's own mount point under the NAS root and
# nothing else.
Cmnd_Alias EVO_NETWORK_SHARES_FORCE_DETACH = \
    /usr/bin/nsenter --mount=/proc/1/ns/mnt -- umount -l /var/lib/evo/music/NAS/*

Cmnd_Alias EVO_NETWORK_SHARES_DISCOVERY = \
    /usr/bin/avahi-browse, \
    /usr/bin/smbclient

Defaults!EVO_NETWORK_SHARES_MOUNT !pam_session, !syslog
# Force is an operator gesture, not a cadence: it stays in the
# journal. No !syslog here.
Defaults!EVO_NETWORK_SHARES_FORCE_DETACH !pam_session
Defaults!EVO_NETWORK_SHARES_DISCOVERY !pam_session, !syslog

@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_NETWORK_SHARES_MOUNT
@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_NETWORK_SHARES_FORCE_DETACH
@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_NETWORK_SHARES_DISCOVERY
