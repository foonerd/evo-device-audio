#!/usr/bin/env bash
# evo-smb-user-sync — narrow root-only SMB user provisioner.
#
# Invoked as:
#   sudo -n /usr/local/bin/evo-smb-user-sync add <username>
#     password on the first line of stdin
#   sudo -n /usr/local/bin/evo-smb-user-sync delete <username>
#
# Normative contract:
#   plugins/org.evoframework.network.smb-server/docs/SAMBA-SHARES.md
#   § SMB users (authenticated access)
#
# Add: ensure a non-login system account (nologin, no home), then
#      smbpasswd -a -s. Never creates a login shell.
# Delete: smbpasswd -x, then userdel ONLY when the NSS entry
#         matches the provisioned shape (nologin + /nonexistent).
#
# This script is the trust boundary for user provisioning. The
# steward must NOT be granted raw useradd / userdel / smbpasswd
# via sudoers — only this wrapper.

set -euo pipefail

ACTION="${1:-}"
USERN="${2:-}"

die() {
  echo "evo-smb-user-sync: $*" >&2
  exit 1
}

[[ -n "${USERN}" ]] || die "missing username"

# Username discipline — matches SAMBA-SHARES.md / volumio-evo.
# The `list` action takes the literal `-` placeholder because
# it's workspace-wide (not per-user); skip the regex there and
# let the per-action branch validate its own argv shape.
if [[ "${ACTION}" != "list" ]]; then
  [[ "${USERN}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] \
    || die "invalid username — use [a-z_][a-z0-9_-]{0,31}"
fi

# Steward service user is substituted at install time for
# `@EVO_SERVICE_USER@` (see bootstrap Step 1f). Hardcoded so
# sudo's env_reset cannot strip the check.
SERVICE_USER="@EVO_SERVICE_USER@"

# Hard blocklist — never promote OS / steward identities to SMB logins.
is_blocked() {
  local n="$1"
  case "${n}" in
    root|nobody|nfsnobody|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|gnats|systemd-network|systemd-resolve|messagebus|sshd|smbd|nmbd|avahi|mpd)
      return 0
      ;;
  esac
  if [[ -n "${SERVICE_USER}" && "${SERVICE_USER}" != "@EVO_SERVICE_USER@" && "${n}" == "${SERVICE_USER}" ]]; then
    return 0
  fi
  return 1
}

# The `list` action is workspace-wide and takes the literal `-`
# placeholder — skip the blocklist check for it. Per-user actions
# (add / delete / adopt) always enforce.
if [[ "${ACTION}" != "list" ]] && is_blocked "${USERN}"; then
  die "username '${USERN}' is reserved — refuse to use as SMB login"
fi

nologin_path() {
  local p
  p="$(command -v nologin 2>/dev/null || true)"
  if [[ -n "${p}" && -x "${p}" ]]; then
    echo "${p}"
    return
  fi
  echo "/usr/sbin/nologin"
}

is_provisioned_shape() {
  # True when NSS entry looks like one we created: nologin/false shell
  # and home /nonexistent (or empty).
  local n="$1"
  id -u "${n}" &>/dev/null || return 1
  local shell home
  shell="$(getent passwd "${n}" | awk -F: '{print $7}')"
  home="$(getent passwd "${n}" | awk -F: '{print $6}')"
  case "${shell}" in
    */nologin|/bin/false|/usr/bin/false) ;;
    *) return 1 ;;
  esac
  case "${home}" in
    /nonexistent|"") ;;
    *) return 1 ;;
  esac
  return 0
}

case "${ACTION}" in
  add)
    IFS= read -r PASS || true
    [[ -n "${PASS}" ]] || die "empty password on stdin"

    # Strict: refuse ANY pre-existing NSS entry. The plugin
    # runtime's in-memory smb_users list catches legitimate
    # duplicate adds BEFORE this wrapper fires — reaching here
    # with an existing NSS entry means the account was created
    # outside plugin control (manual `useradd`, prior distro
    # install, or a knowledgeable operator forging the
    # "provisioned shape"). We do NOT adopt it: the plugin
    # must own every NSS entry it attaches Samba credentials
    # to. If the operator legitimately wants to re-provision
    # a stale entry, they revoke first (which removes NSS +
    # passdb) and then re-add.
    if id -u "${USERN}" &>/dev/null; then
      die "username '${USERN}' already exists on this host — cannot attach. Revoke first if this is an evo-managed user."
    fi

    NOLOGIN="$(nologin_path)"
    useradd -r -s "${NOLOGIN}" -d /nonexistent "${USERN}" \
      || die "useradd failed for ${USERN}"

    # smbpasswd -s reads password twice from stdin. The
    # distribution's `evo.service.d/samba-server-privileges.conf`
    # drop-in carves `/var/lib/samba` out of the framework's
    # `ProtectSystem=strict` posture; without it smbpasswd's
    # write to `passdb.tdb` / `secrets.tdb` fails with EROFS
    # regardless of euid.
    if ! printf '%s\n%s\n' "${PASS}" "${PASS}" \
      | smbpasswd -a -s "${USERN}"; then
      die "smbpasswd -a failed for ${USERN}"
    fi
    ;;

  delete)
    smbpasswd -x "${USERN}" 2>/dev/null || true
    if id -u "${USERN}" &>/dev/null; then
      if is_provisioned_shape "${USERN}"; then
        userdel "${USERN}" 2>/dev/null \
          || die "userdel failed for ${USERN}"
      else
        # Leave foreign NSS accounts alone; passdb row already cleared.
        echo "evo-smb-user-sync: leaving non-provisioned NSS account '${USERN}' in place" >&2
      fi
    fi
    ;;

  adopt)
    # Adopt an existing NSS + passdb entry into evo management.
    # Fires from the runtime's user_add path when the target
    # already exists at the OS layer but is absent from plugin
    # state (typical post-wipe drift: /var/lib/evo/plugins/... is
    # reset by the wipe primitive, but /var/lib/samba + NSS
    # survive). The plugin has to be able to re-key the account
    # from the operator-supplied vault credential instead of
    # refusing outright.
    #
    # Contract:
    #   - NSS entry MUST already exist with provisioned shape
    #     (nologin + /nonexistent). Any other shape refuses — we
    #     don't ever touch OS accounts we didn't create.
    #   - passdb entry MAY or MAY NOT exist:
    #       present -> smbpasswd -s <user> (change password only)
    #       absent  -> smbpasswd -a -s <user> (add + set password)
    #   - Idempotent: repeated adopt with the same password is a
    #     no-op at the OS layer.
    IFS= read -r PASS || true
    [[ -n "${PASS}" ]] || die "empty password on stdin"

    id -u "${USERN}" &>/dev/null \
      || die "cannot adopt: username '${USERN}' has no NSS entry — use 'add' instead"

    is_provisioned_shape "${USERN}" \
      || die "cannot adopt: '${USERN}' NSS entry has non-provisioned shape (login shell or real home) — refusing to touch OS account not created by evo"

    if pdbedit -L 2>/dev/null | grep -qE "^${USERN}:"; then
      # passdb has the user — change password only.
      if ! printf '%s\n%s\n' "${PASS}" "${PASS}" \
        | smbpasswd -s "${USERN}"; then
        die "smbpasswd (change password) failed for ${USERN}"
      fi
    else
      # NSS exists but passdb does not — add passdb entry
      # matching the surviving NSS account.
      if ! printf '%s\n%s\n' "${PASS}" "${PASS}" \
        | smbpasswd -a -s "${USERN}"; then
        die "smbpasswd -a failed for ${USERN}"
      fi
    fi
    ;;

  list)
    # Enumerate passdb — prints one username per line. Used by
    # the runtime's reconcile-on-load path to sync smb_users
    # state against the OS/samba source of truth.
    #
    # Requires sudo because /var/lib/samba/private/passdb.tdb is
    # root-mode-0600. Read-only; no state mutation.
    #
    # Filters to entries with the provisioned shape (nologin +
    # /nonexistent) — anything else is an OS account that
    # happens to have a passdb row and MUST NOT be adopted.
    # Silent empty output when passdb is empty (fresh install).
    #
    # Note: the wrapper's positional argv shape requires a
    # username, but `list` is workspace-wide. Convention: pass
    # the literal "-" as the placeholder so the shape stays
    # consistent with the shell case-dispatch and the
    # sudoers-argv audit surface.
    if [[ "${USERN}" != "-" ]]; then
      die "list requires the literal '-' placeholder as username; got '${USERN}'"
    fi
    # Read every passdb row, filter to provisioned-shape only.
    while IFS=: read -r user_field _uid_field _rest; do
      [[ -n "${user_field}" ]] || continue
      if is_provisioned_shape "${user_field}"; then
        echo "${user_field}"
      fi
    done < <(pdbedit -L 2>/dev/null)
    ;;

  *)
    die "usage: $0 <add|delete|adopt|list> <username|-> (password on stdin for add/adopt)"
    ;;
esac
