# sudoers drop-in template — installed by the bootstrap
# script at /etc/sudoers.d/evo-samba-server with mode 0440,
# owned root:root.
#
# Grants the steward service user (substituted at install
# time for the `@EVO_SERVICE_USER@` placeholder) NOPASSWD
# access to the binaries the framework's SambaServerRuntime
# invokes to render + validate + install /etc/samba/smb.conf,
# manage SMB users, and restart smbd.
#
# Scoped Cmnd_Alias declarations:
#
# 1. `EVO_SAMBA_SERVER_CONFIG` — `testparm -s <candidate>`
#    validates the rendered smb.conf against the samba parser
#    before the runtime installs over /etc/samba/smb.conf.
#    Read-only per invocation but requires elevated read on
#    the target if the operator's candidate path is under
#    a privileged directory.
#
# 2. `EVO_SAMBA_SERVER_USERS` — narrow wrapper
#    `/usr/local/bin/evo-smb-user-sync {add|delete|list} <user|->`.
#    The wrapper creates a non-login system account (nologin,
#    no home) then runs `smbpasswd`; passwords are piped on
#    stdin for `add` (never on argv). The steward MUST NOT be
#    granted raw `useradd` / `userdel` / `smbpasswd` — only
#    this wrapper. See docs/SAMBA-SHARES.md § SMB users.
#
# 3. `EVO_SAMBA_SERVER_RESTART` — `systemctl restart smbd`
#    (enabled=true apply) and `systemctl stop smbd`
#    (enabled=false apply). Disable MUST stop the daemon, not
#    just rewrite the conf — SAMBA-SHARES.md Disable rule.
#
# 4. `EVO_SAMBA_SERVER_HOSTNAME` — `hostnamectl set-hostname
#    <name>`. Fires when the operator supplies `system_hostname`
#    on `network.smb_server.apply`; the runtime pre-validates
#    the name against RFC 1123 before invoking sudo so the
#    argv wildcard only ever carries operator-visible clean
#    strings. avahi-daemon subscribes to hostnamed's D-Bus
#    change signal and re-advertises mDNS automatically on
#    standard Debian; smb.conf re-renders on the same apply,
#    so a single UI gesture updates OS hostname + mDNS + SMB
#    NetBIOS advertisement together.
#
# 5. `EVO_SAMBA_SERVER_INSTALL` — `install -m 0644 -o root -g
#    root /var/tmp/evo-smb.conf.candidate /etc/samba/smb.conf`.
#    The runtime renders the smb.conf into
#    `/var/tmp/evo-smb.conf.candidate` (service-user-writable,
#    no sudo needed to produce the bytes), runs testparm
#    against the candidate, and — on success — invokes
#    `install(1)` under this alias to drop the validated
#    candidate atomically over `/etc/samba/smb.conf`.
#    `install(1)` copies to a temp file adjacent to the
#    target, fsyncs, then renames — smbd never observes a
#    partial rewrite. Both source and target paths are named
#    verbatim so the alias grant matches byte-for-byte and no
#    other install invocation can slip through.
#
# Path discipline: the testparm, evo-smb-user-sync, systemctl
# paths MUST match the runtime builder's defaults
# (`DEFAULT_TESTPARM_PATH` / `DEFAULT_SMB_USER_SYNC_PATH` /
# `DEFAULT_SYSTEMCTL_PATH`). Distributions with non-standard
# paths override via the builder and add new substitutions to
# the bootstrap script.
#
# Argv scoping: the runtime's argv builders emit fixed shapes
# — `testparm -s <path>`, `evo-smb-user-sync add|delete|list
# <user>`, `systemctl restart smbd`, `systemctl stop smbd`.
# The user-sync wrapper is
# the trust boundary for provisioning (username validation +
# blocklist + nologin account shape).
#
# Apply via the bootstrap script:
#   scripts/bootstrap.sh --install-samba-server-sudoers
#
# Or manually (substitute the placeholder):
#   sed 's/@EVO_SERVICE_USER@/<your-service-user>/' \
#       dist/sudoers.d/evo-samba-server.in \
#       | sudo install -m 0440 -o root -g root /dev/stdin \
#         /etc/sudoers.d/evo-samba-server
#
# `visudo -c -f /etc/sudoers.d/evo-samba-server` verifies
# syntactically valid sudoers.

Cmnd_Alias EVO_SAMBA_SERVER_CONFIG = \
    /usr/bin/testparm

Cmnd_Alias EVO_SAMBA_SERVER_USERS = \
    /usr/local/bin/evo-smb-user-sync add *, \
    /usr/local/bin/evo-smb-user-sync delete *, \
    /usr/local/bin/evo-smb-user-sync list *

Cmnd_Alias EVO_SAMBA_SERVER_RESTART = \
    /usr/bin/systemctl restart smbd, \
    /usr/bin/systemctl stop smbd

Cmnd_Alias EVO_SAMBA_SERVER_HOSTNAME = \
    /usr/bin/hostnamectl set-hostname *

Cmnd_Alias EVO_SAMBA_SERVER_INSTALL = \
    /usr/bin/install -m 0644 -o root -g root /var/tmp/evo-smb.conf.candidate /etc/samba/smb.conf

Defaults!EVO_SAMBA_SERVER_CONFIG !pam_session, !syslog
Defaults!EVO_SAMBA_SERVER_USERS !pam_session, !syslog
Defaults!EVO_SAMBA_SERVER_RESTART !pam_session, !syslog
Defaults!EVO_SAMBA_SERVER_HOSTNAME !pam_session, !syslog
Defaults!EVO_SAMBA_SERVER_INSTALL !pam_session, !syslog

@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_SAMBA_SERVER_CONFIG
@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_SAMBA_SERVER_USERS
@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_SAMBA_SERVER_RESTART
@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_SAMBA_SERVER_HOSTNAME
@EVO_SERVICE_USER@ ALL=(root) NOPASSWD: EVO_SAMBA_SERVER_INSTALL
