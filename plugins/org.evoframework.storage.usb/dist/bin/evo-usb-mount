#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Just a Nerd
#
# evo-usb-mount — narrow root-only wrapper for the
# org.evoframework.storage.usb plugin's mount / umount / fsck /
# eject dispatch. Installed by bootstrap.sh at
# /usr/local/bin/evo-usb-mount, mode 0755 root:root. Sole
# privileged target of the EVO_STORAGE_USB sudoers Cmnd_Alias.
#
# The steward MUST NEVER receive raw mount / umount / fsck /
# eject argv. All privileged block-storage operations flow
# through this wrapper. Same trust-boundary discipline as
# /usr/local/bin/evo-smb-user-sync (SMB user provisioning) and
# /usr/local/bin/evo-captive-probe (captive network probing).
#
# Path allowlist for mount targets:
#   /var/lib/evo/music/USB/<stable-id>/
# where <stable-id> matches [A-Za-z0-9][A-Za-z0-9_-]{0,31}
# with optional -p<N> partition suffix (see USB-STORAGE.md §3).
#
# Block-device allowlist for source arguments:
#   /dev/sd[a-z][1-9]*
#   /dev/nvme[0-9]+n[0-9]+p[0-9]+
#   /dev/mmcblk[0-9]+p[0-9]+
#
# Anything outside either allowlist is a defect — the wrapper
# refuses. The runtime's argv builders in
# plugins/org.evoframework.storage.usb/src/runtime.rs are the
# design-time trust boundary; the wrapper is the last-mile
# runtime enforcement.
#
# Mount options passed as a 4th positional argv on the `mount`
# action are validated against a strict allowlist (alphanumeric
# + '=' + ',' + '_' + '-') before being handed to
# systemd-mount. The runtime's fs_matrix.rs builds these
# strings; the wrapper validates + relays. PID 1 attaches the
# volume in the host mount namespace so mpd and the operator
# see the same tree.
#
# Exit codes:
#   0  — action completed successfully
#   1  — invalid invocation (missing / malformed argv)
#   2  — argv failed path / block-device / mount-opts allowlist
#   3  — subprocess (mount / umount / fsck / eject) failed
#   4  — umount refused: target is EBUSY (files open) — operator
#        should stop consumers or retry with `umount-force`
#   42 — action not implemented yet (Step-N stub)

set -euo pipefail

readonly USB_MOUNT_ROOT="/var/lib/evo/music/USB"
readonly STABLE_ID_RE='^[A-Za-z0-9][A-Za-z0-9_-]{0,31}(-p[0-9]+)?$'
readonly DEVICE_NODE_RE='^/dev/(sd[a-z][1-9][0-9]*|nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)$'
readonly PARENT_DISK_RE='^/dev/(sd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$'
readonly FS_TYPE_RE='^(vfat|exfat|ntfs|ext2|ext3|ext4)$'
# Mount-opts allowlist — alphanumeric + '=' + ',' + '_' + '-'
# + '.' (for numeric-with-dot values, e.g. vers=3.1.1 shape).
# Explicitly excludes shell metachars, spaces, and path chars
# to prevent argv injection through the opts field.
readonly MOUNT_OPTS_RE='^[A-Za-z0-9=,_.-]+$'

usage() {
    cat >&2 <<'USAGE'
evo-usb-mount — narrow wrapper for org.evoframework.storage.usb

Usage:
  evo-usb-mount mount        <stable-id> <fs-type> <device-node> <mount-opts>
  evo-usb-mount umount       <stable-id>
  evo-usb-mount umount-force <stable-id>
  evo-usb-mount fsck-check   <stable-id> <fs-type> <device-node>
  evo-usb-mount fsck         <stable-id> <fs-type> <device-node> [escalate]
  evo-usb-mount eject        <parent-disk>
  evo-usb-mount --version
  evo-usb-mount --help

Constraints:
  <stable-id>   matches [A-Za-z0-9][A-Za-z0-9_-]{0,31} (optional -p<N> suffix)
  <fs-type>     one of vfat|exfat|ntfs|ext2|ext3|ext4
  <device-node> matches /dev/sd*[N] or /dev/nvme*n*p* or /dev/mmcblk*p*
  <parent-disk> matches /dev/sd* or /dev/nvme*n* or /dev/mmcblk*
  <mount-opts>  matches [A-Za-z0-9=,_.-]+ (validated allowlist)
  Mount targets always at /var/lib/evo/music/USB/<stable-id>/

Exit codes:
  0  ok
  1  invalid invocation
  2  argv failed allowlist
  3  subprocess failed
  4  umount refused: target EBUSY (use umount-force or stop consumers)
  5  fsck: filesystem is dirty (or repair failed)
  6  fsck: NTFS hiberfile present (resume + shut down Windows cleanly first)
  42 action not implemented (stub)
USAGE
}

die_invocation() {
    echo "evo-usb-mount: $*" >&2
    usage
    exit 1
}

die_allowlist() {
    echo "evo-usb-mount: $*" >&2
    exit 2
}

die_subprocess() {
    echo "evo-usb-mount: subprocess failed: $*" >&2
    exit 3
}

die_busy() {
    echo "evo-usb-mount: target EBUSY: $*" >&2
    exit 4
}

validate_stable_id() {
    local id="$1"
    if [[ ! "${id}" =~ ${STABLE_ID_RE} ]]; then
        die_allowlist "stable-id '${id}' does not match ${STABLE_ID_RE}"
    fi
}

validate_fs_type() {
    local fs="$1"
    if [[ ! "${fs}" =~ ${FS_TYPE_RE} ]]; then
        die_allowlist "fs-type '${fs}' not in ${FS_TYPE_RE}"
    fi
}

validate_device_node() {
    local dev="$1"
    if [[ ! "${dev}" =~ ${DEVICE_NODE_RE} ]]; then
        die_allowlist "device-node '${dev}' does not match ${DEVICE_NODE_RE}"
    fi
    # Refuse a device-node argv that resolves to a symlink pointing
    # outside the allowlist — the wrapper only accepts a literal
    # /dev/ path that the kernel exposes as a block device.
    if [[ ! -b "${dev}" ]]; then
        die_allowlist "device-node '${dev}' is not a block device"
    fi
}

validate_parent_disk() {
    local dev="$1"
    if [[ ! "${dev}" =~ ${PARENT_DISK_RE} ]]; then
        die_allowlist "parent-disk '${dev}' does not match ${PARENT_DISK_RE}"
    fi
    if [[ ! -b "${dev}" ]]; then
        die_allowlist "parent-disk '${dev}' is not a block device"
    fi
}

validate_mount_opts() {
    local opts="$1"
    if [[ ! "${opts}" =~ ${MOUNT_OPTS_RE} ]]; then
        die_allowlist "mount-opts '${opts}' does not match ${MOUNT_OPTS_RE}"
    fi
}

mount_target_for() {
    printf '%s/%s' "${USB_MOUNT_ROOT}" "$1"
}

# Defence-in-depth: refuse to mount / umount a device the kernel
# has as backing for a live system mount. The runtime's classifier
# is the primary gate; this is the wrapper's independent check.
refuse_system_backed_device() {
    local dev="$1"
    # findmnt --source <dev> --mountpoint / — nonzero exit means
    # <dev> is not backing /. Silence stderr; care only about the
    # exit code + mount-point match.
    if findmnt --source "${dev}" --mountpoint / >/dev/null 2>&1 \
       || findmnt --source "${dev}" --mountpoint /boot >/dev/null 2>&1 \
       || findmnt --source "${dev}" --mountpoint /boot/efi >/dev/null 2>&1 \
       || findmnt --source "${dev}" --mountpoint /boot/firmware >/dev/null 2>&1; then
        die_allowlist "device-node '${dev}' backs a live system mount; refusing"
    fi
    # And swap.
    if grep -qE "^${dev}\s+partition" /proc/swaps 2>/dev/null; then
        die_allowlist "device-node '${dev}' is an active swap partition; refusing"
    fi
}

# Run a command as a child of PID 1 so it sees the host mount
# table. nsenter cannot: evo.service has RestrictNamespaces=yes,
# and a sudo child inherits that filter (setns → EPERM). The
# mount path already uses this bus (systemd-mount --collect).
# Never `-l` on systemd-umount (`-l` is `--full` there).
host_run() {
    /usr/bin/systemd-run --quiet --wait --collect --pipe \
        --working-directory=/ -- "$@"
}

# Lazy detach in PID 1's mount namespace. NTFS/exFAT arrive as
# fuseblk: `umount -l` still says "target is busy" while MPD is
# indexing. fusermount -uz is the FUSE lazy detach. util-linux
# `umount -l` stays the fallback for non-FUSE.
lazy_detach_host() {
    local target="$1"
    local lazy_stderr rc=1
    local fuse_bin=""
    if [[ -x /usr/bin/fusermount3 ]]; then
        fuse_bin=/usr/bin/fusermount3
    elif [[ -x /bin/fusermount3 ]]; then
        fuse_bin=/bin/fusermount3
    elif [[ -x /usr/bin/fusermount ]]; then
        fuse_bin=/usr/bin/fusermount
    elif [[ -x /bin/fusermount ]]; then
        fuse_bin=/bin/fusermount
    fi
    if [[ -n "${fuse_bin}" ]]; then
        lazy_stderr="$(host_run "${fuse_bin}" -uz "${target}" 2>&1)" && rc=0 || rc=$?
        if [[ $rc -eq 0 ]]; then
            return 0
        fi
    fi
    lazy_stderr="$(host_run /bin/umount -i -l "${target}" 2>&1)" && rc=0 || rc=$?
    if [[ $rc -ne 0 ]]; then
        die_subprocess "lazy detach of ${target} in the host namespace: ${lazy_stderr}"
    fi
}

case "${1:-}" in
    --version)
        # Stable version string bootstrap + installer can grep for.
        # Bump when the wrapper's argv shape changes.
        echo "evo-usb-mount 7"
        exit 0
        ;;
    --help|-h|"")
        usage
        exit 0
        ;;
    mount)
        [[ $# -eq 5 ]] || die_invocation "mount requires 4 args: <stable-id> <fs-type> <device-node> <mount-opts>"
        validate_stable_id "$2"
        validate_fs_type "$3"
        validate_device_node "$4"
        validate_mount_opts "$5"
        refuse_system_backed_device "$4"
        target="$(mount_target_for "$2")"
        # install(1) creates the target dir with the correct mode +
        # owner. -d creates parents; -m sets mode; the service user
        # of the calling steward isn't visible here so we set world-
        # traversable 0755 and let the mount option uid=/gid= handle
        # the file-owner semantics for FAT-family filesystems.
        install -d -m 0755 "${target}" || die_subprocess "install -d ${target}"
        # Host truth is PID 1's mount table. findmnt without
        # --task 1 reads THIS namespace (the steward's private
        # ns under ProtectSystem=strict). A leftover FUSE there
        # is invisible to mpd and the operator, and must not
        # count as mounted.
        if findmnt --task 1 --mountpoint "${target}" --source "$4" >/dev/null 2>&1; then
            exit 0
        fi
        if findmnt --task 1 --mountpoint "${target}" >/dev/null 2>&1; then
            die_subprocess "target '${target}' already has a different mount source in the host namespace"
        fi
        # Drop a leftover in this namespace (previous raw mount(8)
        # or a dead device node after unplug). systemd-umount
        # talks to PID 1 and cannot see it.
        if findmnt --mountpoint "${target}" >/dev/null 2>&1; then
            umount "${target}" 2>/dev/null \
                || umount -l "${target}" \
                || die_subprocess "umount leftover ${target} in this namespace"
        fi
        # §2 NTFS options (windows_names, big_writes, dmask, fmask)
        # are ntfs-3g. systemd-mount --type=ntfs on a kernel that
        # ships ntfs3 uses the in-kernel driver, which rejects
        # those options. mount(8) -t ntfs used /sbin/mount.ntfs
        # → ntfs-3g; keep that helper.
        systemd_type="$3"
        if [[ "$3" == "ntfs" ]]; then
            if [[ ! -x /bin/ntfs-3g && ! -x /usr/bin/ntfs-3g && ! -x /sbin/mount.ntfs-3g ]]; then
                die_subprocess "ntfs-3g is required to mount NTFS"
            fi
            systemd_type="ntfs-3g"
        fi
        # systemd-mount --collect asks PID 1 to attach the volume in
        # the host mount namespace. --fsck=no: this wrapper owns
        # dirty detection via fsck-check / fsck.
        mount_stderr="$(/usr/bin/systemd-mount --collect --fsck=no --no-ask-password \
            --type="${systemd_type}" --options="$5" "$4" "${target}" 2>&1)" && rc=0 || rc=$?
        if [[ $rc -ne 0 ]]; then
            die_subprocess "systemd-mount --type=${systemd_type} $4 ${target}: ${mount_stderr}"
        fi
        if ! findmnt --task 1 --mountpoint "${target}" --source "$4" >/dev/null 2>&1; then
            die_subprocess "systemd-mount returned 0 but the host namespace does not show ${target} from $4"
        fi
        exit 0
        ;;
    umount)
        [[ $# -eq 2 ]] || die_invocation "umount requires 1 arg: <stable-id>"
        validate_stable_id "$2"
        target="$(mount_target_for "$2")"
        # Host first; then a leftover that exists only in this
        # namespace (ProtectSystem private ns).
        if ! findmnt --task 1 --mountpoint "${target}" >/dev/null 2>&1; then
            if findmnt --mountpoint "${target}" >/dev/null 2>&1; then
                umount "${target}" 2>/dev/null || umount -l "${target}" \
                    || die_subprocess "umount leftover ${target} in this namespace"
            fi
            rmdir "${target}" 2>/dev/null || true
            exit 0
        fi
        # Try a clean umount first; distinguish EBUSY from other
        # failures so the runtime can decide whether to escalate
        # to umount-force.
        umount_stderr="$(/usr/bin/systemd-umount "${target}" 2>&1)" && rc=0 || rc=$?
        if [[ $rc -eq 0 ]]; then
            # Empty-only rmdir cleanup so the leaf mount root
            # doesn't stay lingering.
            rmdir "${target}" 2>/dev/null || true
            exit 0
        fi
        # umount exit code semantics vary across versions. Detect
        # EBUSY by the stderr wording instead. util-linux says
        # "target is busy" (stable since 2.30 across the fleet);
        # systemd renders the same EBUSY as "Device or resource
        # busy", and only util-linux's wording was matched here —
        # so a real EBUSY from systemd-umount left as exit 3 and
        # the exit-4 contract in this file's header never fired
        # on the path that produces it. Folded to lower case so
        # the capitalised systemd wording matches too.
        umount_stderr_lc="${umount_stderr,,}"
        if [[ "${umount_stderr_lc}" == *"target is busy"* ]] \
           || [[ "${umount_stderr_lc}" == *"device is busy"* ]] \
           || [[ "${umount_stderr_lc}" == *"device or resource busy"* ]]; then
            die_busy "${target}: ${umount_stderr}"
        fi
        die_subprocess "systemd-umount ${target}: ${umount_stderr}"
        ;;
    umount-force)
        [[ $# -eq 2 ]] || die_invocation "umount-force requires 1 arg: <stable-id>"
        validate_stable_id "$2"
        target="$(mount_target_for "$2")"
        if ! findmnt --task 1 --mountpoint "${target}" >/dev/null 2>&1; then
            if findmnt --mountpoint "${target}" >/dev/null 2>&1; then
                umount -l "${target}" \
                    || die_subprocess "umount -l leftover ${target} in this namespace"
            fi
            rmdir "${target}" 2>/dev/null || true
            exit 0
        fi
        # Force means force. Ask systemd for a clean unmount
        # first so it retires its own transient unit when it
        # can; escalate to a real lazy detach when the target is
        # held. The lazy detach is host_run (PID 1), not
        # nsenter: RestrictNamespaces=yes makes setns EPERM.
        #
        # Operator has acknowledged the data-loss risk at the
        # storage.usb.safe_remove verb.
        if /usr/bin/systemd-umount "${target}" >/dev/null 2>&1; then
            rmdir "${target}" 2>/dev/null || true
            exit 0
        fi
        lazy_detach_host "${target}"
        rmdir "${target}" 2>/dev/null || true
        exit 0
        ;;
    fsck-check)
        # Dry-run dirty detection per USB-STORAGE.md §2. Never
        # writes to the device; returns:
        #   exit 0 — clean
        #   exit 5 — dirty (needs repair)
        #   exit 6 — NTFS hiberfile present (unrepairable via
        #            ntfsfix; operator must resume + shut down
        #            Windows cleanly first)
        #   exit 3 — subprocess failed (missing binary etc.)
        [[ $# -eq 4 ]] || die_invocation "fsck-check requires 3 args: <stable-id> <fs-type> <device-node>"
        validate_stable_id "$2"
        validate_fs_type "$3"
        validate_device_node "$4"
        refuse_system_backed_device "$4"
        # Device must NOT be currently mounted anywhere — fsck on
        # a mounted-rw filesystem is unsafe.
        if findmnt --source "$4" >/dev/null 2>&1; then
            die_allowlist "device-node '$4' is currently mounted; fsck-check requires unmounted device"
        fi
        case "$3" in
            vfat)
                # fsck.vfat -n exit code: 0=clean, 1=dirty, other=io/setup fail
                if fsck.vfat -n "$4" >/dev/null 2>&1; then
                    exit 0
                fi
                rc=$?
                [[ $rc -eq 1 ]] && exit 5
                die_subprocess "fsck.vfat -n $4 exit ${rc}"
                ;;
            exfat)
                # fsck.exfat -n : 0=clean, non-zero=dirty
                if fsck.exfat -n "$4" >/dev/null 2>&1; then
                    exit 0
                fi
                exit 5
                ;;
            ntfs)
                # ntfsfix --no-action -d : does not write; reports
                # dirty or hiberfile in stderr. We parse stderr
                # for the two distinct conditions.
                nf_stderr="$(ntfsfix --no-action -d "$4" 2>&1)" && nf_rc=0 || nf_rc=$?
                if [[ "${nf_stderr}" == *"hiberfil.sys"* ]] \
                   || [[ "${nf_stderr}" == *"hibernated Windows"* ]]; then
                    exit 6
                fi
                if [[ $nf_rc -eq 0 ]] \
                   && [[ "${nf_stderr}" != *"needs to be repaired"* ]] \
                   && [[ "${nf_stderr}" != *"is dirty"* ]]; then
                    exit 0
                fi
                exit 5
                ;;
            ext2|ext3|ext4)
                # dumpe2fs -h : the header carries the dirty flag
                # (via features / state fields). Exit 0 + state
                # "clean" + no needs_recovery feature = clean.
                dump_out="$(dumpe2fs -h "$4" 2>/dev/null)" || die_subprocess "dumpe2fs -h $4"
                state=$(echo "${dump_out}" | grep -E "^Filesystem state:" | head -1 | awk -F: '{print $2}' | tr -d ' ')
                needs_recovery=$(echo "${dump_out}" | grep -qE "features:.*needs_recovery" && echo 1 || echo 0)
                if [[ "${state}" == "clean" && "${needs_recovery}" == "0" ]]; then
                    exit 0
                fi
                exit 5
                ;;
        esac
        die_allowlist "fsck-check: unreachable branch for fs '$3'"
        ;;
    fsck)
        # Repair action. Runs the per-FS auto-repair tool per
        # USB-STORAGE.md §2. Called from the runtime's
        # repair_filesystem verb AFTER umount. The runtime is
        # responsible for consumer-stop + sync + umount BEFORE
        # invoking this action.
        #
        # Exit codes:
        #   0  — repair succeeded (drive is now clean; caller
        #        should attempt remount)
        #   5  — repair failed (drive stays dirty; operator
        #        must reformat or restore from backup)
        #   6  — NTFS hiberfile refuse (ntfsfix will not touch it;
        #        operator must resume + shut down Windows first)
        #   3  — subprocess failed (missing binary etc.)
        #
        # Optional 4th positional arg `escalate` (any non-empty
        # string) opts into the tool's more-aggressive mode
        # (`e2fsck -y` instead of `-p`). Operator confirms this
        # explicitly at the verb layer via `escalate: true`.
        [[ $# -eq 4 || $# -eq 5 ]] || die_invocation "fsck requires 3 or 4 args: <stable-id> <fs-type> <device-node> [escalate]"
        validate_stable_id "$2"
        validate_fs_type "$3"
        validate_device_node "$4"
        refuse_system_backed_device "$4"
        if findmnt --source "$4" >/dev/null 2>&1; then
            die_allowlist "device-node '$4' is currently mounted; fsck repair requires unmounted device"
        fi
        escalate="${5:-}"
        case "$3" in
            vfat)
                # fsck.vfat -a: auto-repair (accept defaults).
                # No escalated mode — vfat repair is one-shot.
                if fsck.vfat -a "$4" >/dev/null 2>&1; then
                    exit 0
                fi
                exit 5
                ;;
            exfat)
                # fsck.exfat -a (or -y depending on exfatprogs
                # version). Debian trixie ships exfatprogs 1.2+
                # which accepts -a as an auto-repair alias for
                # -y. Try -a first; fall back to -y on invocation
                # failure.
                if fsck.exfat -a "$4" >/dev/null 2>&1; then
                    exit 0
                fi
                if fsck.exfat -y "$4" >/dev/null 2>&1; then
                    exit 0
                fi
                exit 5
                ;;
            ntfs)
                # ntfsfix: no --auto flag; the default action IS
                # auto-repair. It refuses to touch a volume with
                # an active hiberfile — surface that condition
                # distinctly so the runtime maps it to
                # mounted-dirty-hiberfile.
                nf_stderr="$(ntfsfix "$4" 2>&1)" && nf_rc=0 || nf_rc=$?
                if [[ "${nf_stderr}" == *"hiberfil.sys"* ]] \
                   || [[ "${nf_stderr}" == *"hibernated Windows"* ]]; then
                    exit 6
                fi
                [[ $nf_rc -eq 0 ]] && exit 0
                exit 5
                ;;
            ext2|ext3|ext4)
                # e2fsck -p: auto-repair for safe changes only.
                # If escalate is set, use -y (accept every prompt).
                if [[ -n "${escalate}" ]]; then
                    e2fsck -y "$4" >/dev/null 2>&1 && exit 0
                    exit 5
                fi
                e2fsck -p "$4" >/dev/null 2>&1 && exit 0
                # e2fsck -p returns non-zero for anything needing
                # operator input; escalate is the operator's
                # explicit acknowledgement to accept those.
                exit 5
                ;;
        esac
        die_allowlist "fsck: unreachable branch for fs '$3'"
        ;;
    eject)
        [[ $# -eq 2 ]] || die_invocation "eject requires 1 arg: <parent-disk>"
        validate_parent_disk "$2"
        refuse_system_backed_device "$2"
        # SCSI eject via eject(1). Best-effort — some USB drives
        # (Samsung T7, many SSD enclosures) simply do not respond
        # to the eject ioctl. Non-zero exit is logged by the
        # runtime but not fatal to safe-remove.
        eject "$2" || die_subprocess "eject $2"
        exit 0
        ;;
    *)
        die_invocation "unknown action '$1'"
        ;;
esac
